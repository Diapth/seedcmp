{
  "name": "chat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.55.0",
    "@tsdaodao/base-vue": "workspace:*",
    "@tsdaodao/contacts-vue": "workspace:*",
    "@tsdaodao/datasource-vue": "workspace:*",
    "@tsdaodao/login-vue": "workspace:*",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "wukongimjssdk": "^1.2.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.2",
    "vite": "^5.2.2",
    "vitest": "^1.0.0",
    "vue-tsc": "^2.0.6"
  }
}
